---
interface StorageMedium {
  id: number;
  type: string;
  label: string;
  brand?: string;
  model?: string;
  size_gb?: number;
  free_gb?: number;
  notes?: string;
  color: string;
  color_primary?: string;
  color_secondary?: string;
}

interface Props {
  storage: StorageMedium;
}

const { storage } = Astro.props;

const ACCENT_COLORS = ["#6366f1","#8b5cf6","#ec4899","#ef4444","#f59e0b","#10b981","#06b6d4","#3b82f6"];
const PRIMARY_COLORS = ["#dc2626","#ea580c","#d97706","#16a34a","#2563eb","#7c3aed","#db2777","#e5e7eb"];
const SECONDARY_COLORS = ["#1c1c2e","#111827","#1e293b","#0f172a","#18181b","#374151","#292524","#1a1a1a"];
const PCB_COLORS = ["#15803d","#166534","#14532d","#1e3a5f","#1e1b4b","#1c1c2e","#111827","#18181b"];

const initialPrimary = storage.color_primary ?? (storage.type === "ssd" ? "#15803d" : "#dc2626");
const initialSecondary = storage.color_secondary ?? "#1c1c2e";
---

<div
  id="edit-storage-modal"
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm p-0 sm:p-4"
  data-storage-id={storage.id}
  data-storage-type={storage.type}
  data-color={storage.color}
  data-color-primary={initialPrimary}
  data-color-secondary={initialSecondary}
>
  <div class="modal-sheet-content card w-full sm:max-w-lg max-h-[88dvh] sm:max-h-[90vh] overflow-y-auto overscroll-contain rounded-t-3xl sm:rounded-2xl rounded-b-none sm:rounded-b-2xl border-t sm:border border-x-0 sm:border-x border-b-0 sm:border-b border-border dark:border-border-dark p-5 sm:p-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] space-y-5 bg-white dark:bg-surface-dark shadow-2xl">
    <div class="sm:hidden flex justify-center pt-1 pb-2 -mt-1 cursor-grab touch-none" data-sheet-handle>
      <div class="w-12 h-1.5 rounded-full bg-slate-300 dark:bg-white/20"></div>
    </div>
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold">Edit Storage</h2>
      <button type="button" class="btn-ghost p-1.5" data-close-modal aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Label -->
    <div>
      <label class="label" for="edit-storage-label">Label *</label>
      <input id="edit-storage-label" class="input" value={storage.label} placeholder="e.g. SanDisk Pro 512GB" />
    </div>

    <!-- Brand + Model -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="label" for="edit-storage-brand">Brand</label>
        <input id="edit-storage-brand" class="input" value={storage.brand ?? ""} placeholder="SanDisk" />
      </div>
      <div>
        <label class="label" for="edit-storage-model">Model</label>
        <input id="edit-storage-model" class="input" value={storage.model ?? ""} placeholder="Extreme Pro" />
      </div>
    </div>

    <!-- Size + Free -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="label" for="edit-storage-size">Size (GB)</label>
        <input id="edit-storage-size" type="number" class="input" value={storage.size_gb ?? ""} placeholder="512" min="0" />
      </div>
      <div>
        <label class="label" for="edit-storage-free">Free (GB)</label>
        <input id="edit-storage-free" type="number" class="input" value={storage.free_gb ?? ""} placeholder="256" min="0" />
      </div>
    </div>

    <!-- Notes -->
    <div>
      <label class="label" for="edit-storage-notes">Notes</label>
      <textarea id="edit-storage-notes" class="input resize-none h-20" placeholder="Optional notes…">{storage.notes ?? ""}</textarea>
    </div>

    <!-- SD Card color preview + pickers -->
    {storage.type === "sdcard" && (
      <div>
        <div>
          <label class="label">Card Preview</label>
          <div class="rounded-xl overflow-hidden flex flex-col shadow-sm" style="height:72px">
            <div
              id="edit-card-preview-top"
              class="flex items-center justify-center text-white text-xs font-bold px-3 truncate flex-shrink-0"
              style={`background:${initialPrimary}; height:40%`}
            >
              {storage.brand || "Brand"}{storage.model ? ` · ${storage.model}` : ""}
            </div>
            <div
              id="edit-card-preview-bottom"
              class="flex items-center justify-center text-white text-sm font-bold px-3 truncate"
              style={`background:${initialSecondary}; height:60%`}
            >
              {storage.size_gb ? `${storage.size_gb} GB` : "Capacity"}
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div>
            <label class="label">Top Color (Brand)</label>
            <div class="flex gap-1.5 flex-wrap" id="edit-top-color-picker">
              {PRIMARY_COLORS.map((c) => (
                <button
                  type="button"
                  data-color={c}
                  class={`w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all ${
                    c.toLowerCase() === initialPrimary.toLowerCase() ? "ring-2 ring-slate-400 scale-110" : "opacity-70 hover:opacity-100"
                  }`}
                  style={`background:${c}`}
                  aria-label={c}
                ></button>
              ))}
              <input
                id="edit-custom-top-color"
                type="color"
                value={initialPrimary}
                class="w-7 h-7 rounded-full cursor-pointer border-0 bg-transparent p-0"
              />
            </div>
          </div>

          <div>
            <label class="label">Bottom Color (Body)</label>
            <div class="flex gap-1.5 flex-wrap" id="edit-bottom-color-picker">
              {SECONDARY_COLORS.map((c) => (
                <button
                  type="button"
                  data-color={c}
                  class={`w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all ${
                    c.toLowerCase() === initialSecondary.toLowerCase() ? "ring-2 ring-slate-400 scale-110" : "opacity-70 hover:opacity-100"
                  }`}
                  style={`background:${c}`}
                  aria-label={c}
                ></button>
              ))}
              <input
                id="edit-custom-bottom-color"
                type="color"
                value={initialSecondary}
                class="w-7 h-7 rounded-full cursor-pointer border-0 bg-transparent p-0"
              />
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- SSD PCB color -->
    {storage.type === "ssd" && (
      <div>
        <label class="label">PCB Color</label>
        <div class="flex gap-1.5 flex-wrap items-center" id="edit-pcb-color-picker">
          {PCB_COLORS.map((c) => (
            <button
              type="button"
              data-color={c}
              class={`w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all ${
                c.toLowerCase() === initialPrimary.toLowerCase() ? "ring-2 ring-slate-400 scale-110" : "opacity-70 hover:opacity-100"
              }`}
              style={`background:${c}`}
              aria-label={c}
            ></button>
          ))}
          <input
            id="edit-custom-pcb-color"
            type="color"
            value={initialPrimary}
            class="w-7 h-7 rounded-full cursor-pointer border-0 bg-transparent p-0"
          />
        </div>
      </div>
    )}

    <!-- Sidebar accent color -->
    <div>
      <label class="label">Accent Color</label>
      <div class="flex gap-2 flex-wrap" id="edit-accent-color-picker">
        {ACCENT_COLORS.map((c) => (
          <button
            type="button"
            data-color={c}
            class={`w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all ${
              c.toLowerCase() === storage.color.toLowerCase() ? "ring-2 ring-slate-400 scale-110" : "opacity-70 hover:opacity-100"
            }`}
            style={`background:${c}`}
            aria-label={c}
          ></button>
        ))}
        <input
          id="edit-custom-accent-color"
          type="color"
          value={storage.color}
          class="w-7 h-7 rounded-full cursor-pointer border-0 bg-transparent p-0"
        />
      </div>
    </div>

    <div id="edit-storage-error" class="hidden text-sm text-red-500"></div>

    <div class="flex gap-3 pt-1">
      <button type="button" class="btn-ghost flex-1" data-close-modal>Cancel</button>
      <button type="button" class="btn-primary flex-1" id="edit-storage-submit-btn">Save Changes</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("edit-storage-modal");
  const storageId = modal?.dataset.storageId;
  const closeBtns = modal?.querySelectorAll("[data-close-modal]");
  const submitBtn = document.getElementById("edit-storage-submit-btn") as HTMLButtonElement | null;
  const errorEl = document.getElementById("edit-storage-error");

  const labelInput = document.getElementById("edit-storage-label") as HTMLInputElement | null;
  const brandInput = document.getElementById("edit-storage-brand") as HTMLInputElement | null;
  const modelInput = document.getElementById("edit-storage-model") as HTMLInputElement | null;
  const sizeInput = document.getElementById("edit-storage-size") as HTMLInputElement | null;
  const freeInput = document.getElementById("edit-storage-free") as HTMLInputElement | null;
  const notesInput = document.getElementById("edit-storage-notes") as HTMLTextAreaElement | null;

  const cardPreviewTop = document.getElementById("edit-card-preview-top");
  const cardPreviewBottom = document.getElementById("edit-card-preview-bottom");

  const customPcbColor = document.getElementById("edit-custom-pcb-color") as HTMLInputElement | null;
  const customTopColor = document.getElementById("edit-custom-top-color") as HTMLInputElement | null;
  const customBottomColor = document.getElementById("edit-custom-bottom-color") as HTMLInputElement | null;
  const customAccentColor = document.getElementById("edit-custom-accent-color") as HTMLInputElement | null;

  let currentColor = modal?.dataset.color || "#6366f1";
  let currentColorPrimary = modal?.dataset.colorPrimary || "#dc2626";
  let currentColorSecondary = modal?.dataset.colorSecondary || "#1c1c2e";

  function updatePreview() {
    if (!cardPreviewTop || !cardPreviewBottom) return;
    const brand = brandInput?.value.trim() || "Brand";
    const model = modelInput?.value.trim();
    cardPreviewTop.textContent = model ? `${brand} · ${model}` : brand;
    cardPreviewTop.style.background = currentColorPrimary;

    const size = sizeInput?.value.trim();
    cardPreviewBottom.textContent = size ? `${size} GB` : "Capacity";
    cardPreviewBottom.style.background = currentColorSecondary;
  }

  [brandInput, modelInput, sizeInput].forEach((input) => {
    input?.addEventListener("input", updatePreview);
  });

  function setupColorPicker(
    containerId: string,
    onColorChosen: (c: string) => void,
    customInput?: HTMLInputElement | null
  ) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const buttons = container.querySelectorAll<HTMLButtonElement>("button[data-color]");

    function selectColor(color: string) {
      onColorChosen(color);
      buttons.forEach((btn) => {
        const isMatch = btn.dataset.color?.toLowerCase() === color.toLowerCase();
        if (isMatch) {
          btn.className = "w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all ring-2 ring-slate-400 scale-110";
        } else {
          btn.className = "w-7 h-7 rounded-full ring-offset-2 ring-offset-white dark:ring-offset-surface-dark transition-all opacity-70 hover:opacity-100";
        }
      });
      if (customInput) customInput.value = color;
      updatePreview();
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const c = btn.dataset.color;
        if (c) selectColor(c);
      });
    });

    customInput?.addEventListener("input", () => {
      selectColor(customInput.value);
    });
  }

  setupColorPicker("edit-top-color-picker", (c) => { currentColorPrimary = c; }, customTopColor);
  setupColorPicker("edit-bottom-color-picker", (c) => { currentColorSecondary = c; }, customBottomColor);
  setupColorPicker("edit-pcb-color-picker", (c) => { currentColorPrimary = c; }, customPcbColor);
  setupColorPicker("edit-accent-color-picker", (c) => { currentColor = c; }, customAccentColor);

  const sheetContent = modal?.querySelector<HTMLElement>(".modal-sheet-content");
  const sheetHandle = modal?.querySelector<HTMLElement>("[data-sheet-handle]");

  let touchStartY = 0;
  let touchDeltaY = 0;

  sheetHandle?.addEventListener("touchstart", (e) => {
    touchStartY = e.touches[0].clientY;
    touchDeltaY = 0;
    if (sheetContent) sheetContent.style.transition = "none";
  }, { passive: true });

  sheetHandle?.addEventListener("touchmove", (e) => {
    touchDeltaY = e.touches[0].clientY - touchStartY;
    if (touchDeltaY > 0 && sheetContent) {
      sheetContent.style.transform = `translateY(${touchDeltaY}px)`;
    }
  }, { passive: true });

  sheetHandle?.addEventListener("touchend", () => {
    if (sheetContent) {
      sheetContent.style.transition = "transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)";
      if (touchDeltaY > 60) {
        sheetContent.style.transform = "translateY(100%)";
        setTimeout(closeModal, 180);
      } else {
        sheetContent.style.transform = "";
      }
    }
    touchStartY = 0;
    touchDeltaY = 0;
  });

  function closeModal() {
    if (modal) {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }
    if (sheetContent) {
      sheetContent.style.transform = "";
      sheetContent.style.transition = "";
    }
  }

  function openModal() {
    if (modal) {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      if (labelInput) labelInput.focus();
    }
  }

  closeBtns?.forEach((btn) => btn.addEventListener("click", closeModal));

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  submitBtn?.addEventListener("click", async () => {
    const label = labelInput?.value.trim();
    if (!label) {
      if (errorEl) {
        errorEl.textContent = "Label is required";
        errorEl.classList.remove("hidden");
      }
      return;
    }

    if (errorEl) errorEl.classList.add("hidden");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Saving…";
    }

    try {
      const res = await fetch(`/api/storage/${storageId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          label,
          brand: brandInput?.value.trim() || null,
          model: modelInput?.value.trim() || null,
          size_gb: sizeInput?.value ? parseFloat(sizeInput.value) : null,
          free_gb: freeInput?.value ? parseFloat(freeInput.value) : null,
          notes: notesInput?.value.trim() || null,
          color: currentColor,
          color_primary: currentColorPrimary,
          color_secondary: currentColorSecondary,
        }),
      });

      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        throw new Error(d.detail ?? "Failed to update");
      }

      (window as any).setPendingToast?.("Storage updated!");
      closeModal();
      window.location.reload();
    } catch (e: any) {
      if (errorEl) {
        errorEl.textContent = e.message || "Failed to update storage";
        errorEl.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Save Changes";
      }
    }
  });

  (window as any).openEditStorageModal = openModal;
</script>

<style>
  @media (max-width: 639px) {
    .modal-sheet-content {
      animation: sheetSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes sheetSlideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
