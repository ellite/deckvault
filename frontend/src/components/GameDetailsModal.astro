---
interface StorageOption {
  id: number;
  label: string;
  type: string;
  color?: string;
}

interface InstalledGame {
  igdb_id?: number | null;
  title: string;
  storage_id: number;
  storage_label: string;
  storage_color?: string;
  storage_type?: string;
}

interface Props {
  storageList: StorageOption[];
  installedGames?: InstalledGame[];
}

const { storageList = [], installedGames = [] } = Astro.props;

function typeLabel(type: string) {
  const map: Record<string, string> = { local: "Internal", sdcard: "SD Card", hdd: "HDD", ssd: "SSD" };
  return map[type] ?? type;
}
---

<div
  id="game-details-modal"
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-black/60 backdrop-blur-sm p-0 sm:p-4"
  data-installed-games={JSON.stringify(installedGames)}
>
  <div class="modal-sheet-content card w-full sm:max-w-xl max-h-[88dvh] sm:max-h-[90vh] overflow-y-auto overscroll-contain rounded-t-3xl sm:rounded-2xl rounded-b-none sm:rounded-b-2xl border-t sm:border border-x-0 sm:border-x border-b-0 sm:border-b border-border dark:border-border-dark p-5 sm:p-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] space-y-4 bg-white dark:bg-surface-dark shadow-2xl">
    <!-- Mobile drag handle -->
    <div class="sm:hidden flex justify-center pt-1 pb-2 -mt-1 cursor-grab touch-none" data-sheet-handle>
      <div class="w-12 h-1.5 rounded-full bg-slate-300 dark:bg-white/20"></div>
    </div>

    <!-- Header with title and close button -->
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <h2 id="modal-game-title" class="text-xl font-bold leading-tight line-clamp-2">Game Details</h2>
        <div id="modal-game-chips" class="flex flex-wrap items-center gap-1.5 mt-2"></div>
      </div>
      <button type="button" class="btn-ghost p-1.5 flex-shrink-0" data-close-modal aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Hero / Info -->
    <div class="flex flex-col sm:flex-row gap-4">
      <!-- Cover image button to trigger full screen view -->
      <button
        type="button"
        id="modal-game-cover-btn"
        class="w-28 sm:w-36 aspect-[3/4] rounded-xl overflow-hidden bg-slate-100 dark:bg-white/5 flex-shrink-0 mx-auto sm:mx-0 shadow-md ring-1 ring-border dark:ring-border-dark flex items-center justify-center relative group/cover cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:cursor-default"
        title="Click to view full screen poster"
        aria-label="Click to view full screen poster"
      >
        <img
          id="modal-game-cover"
          src=""
          alt=""
          class="w-full h-full object-cover hidden transition-transform duration-200 group-hover/cover:scale-105"
          referrerpolicy="no-referrer"
        />
        <svg id="modal-game-fallback" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
        </svg>

        <!-- Hover overlay icon hint -->
        <div id="modal-cover-zoom-icon" class="absolute inset-0 bg-black/40 opacity-0 group-hover/cover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none hidden">
          <div class="w-8 h-8 rounded-full bg-black/60 backdrop-blur-sm text-white flex items-center justify-center shadow">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
            </svg>
          </div>
        </div>
      </button>

      <!-- Platforms & Summary -->
      <div class="flex-1 min-w-0 flex flex-col gap-2.5">
        <div id="modal-game-platforms-container" class="hidden">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Platforms</p>
          <p id="modal-game-platforms" class="text-xs text-slate-700 dark:text-slate-300 mt-0.5 line-clamp-2"></p>
        </div>

        <div>
          <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Summary</p>
          <p id="modal-game-summary" class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed max-h-36 overflow-y-auto">
            No description available.
          </p>
        </div>
      </div>
    </div>

    <!-- Installed status badges (if already in library) -->
    <div id="modal-installed-section" class="hidden p-3 rounded-xl bg-slate-50 dark:bg-white/5 border border-border dark:border-border-dark">
      <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Already in your library:</p>
      <div id="modal-installed-list" class="flex flex-wrap gap-1.5"></div>
    </div>

    <!-- Add to Storage Section -->
    <div class="pt-3 border-t border-border dark:border-border-dark space-y-3">
      <h3 class="text-sm font-bold">Add to Storage</h3>

      {storageList.length === 0 ? (
        <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 text-xs flex items-center justify-between">
          <span>You need a storage medium before adding games.</span>
          <a href="/storage" class="underline font-semibold ml-2">Add Storage</a>
        </div>
      ) : (
        <div class="flex flex-col sm:flex-row gap-2">
          <div class="flex-1 min-w-0">
            <select
              id="modal-storage-select"
              class="input bg-slate-50 dark:bg-surface-dark text-slate-800 dark:text-slate-200"
            >
              {storageList.map((s, i) => (
                <option value={s.id} selected={i === 0}>
                  {s.label} ({typeLabel(s.type)})
                </option>
              ))}
            </select>
          </div>
          <button
            type="button"
            id="modal-add-storage-btn"
            class="btn-primary flex items-center justify-center gap-1.5 whitespace-nowrap"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Add to Storage
          </button>
        </div>
      )}

      <div id="modal-add-error" class="hidden text-xs text-red-500"></div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("game-details-modal");
  const sheetContent = modal?.querySelector<HTMLElement>(".modal-sheet-content");
  const sheetHandle = modal?.querySelector<HTMLElement>("[data-sheet-handle]");
  const closeBtns = modal?.querySelectorAll("[data-close-modal]");

  const titleEl = document.getElementById("modal-game-title");
  const chipsEl = document.getElementById("modal-game-chips");
  const coverImg = document.getElementById("modal-game-cover") as HTMLImageElement | null;
  const fallbackSvg = document.getElementById("modal-game-fallback");
  const coverBtn = document.getElementById("modal-game-cover-btn") as HTMLButtonElement | null;
  const coverZoomIcon = document.getElementById("modal-cover-zoom-icon");

  const platformsContainer = document.getElementById("modal-game-platforms-container");
  const platformsEl = document.getElementById("modal-game-platforms");
  const summaryEl = document.getElementById("modal-game-summary");

  const installedSection = document.getElementById("modal-installed-section");
  const installedList = document.getElementById("modal-installed-list");

  const storageSelect = document.getElementById("modal-storage-select") as HTMLSelectElement | null;
  const addBtn = document.getElementById("modal-add-storage-btn") as HTMLButtonElement | null;
  const errorEl = document.getElementById("modal-add-error");

  let currentGame: any = null;
  let installedData: any[] = [];
  try {
    installedData = JSON.parse(modal?.dataset.installedGames || "[]");
  } catch {}

  // Touch drag down on handle to close
  let touchStartY = 0;
  let touchDeltaY = 0;

  sheetHandle?.addEventListener("touchstart", (e) => {
    touchStartY = e.touches[0].clientY;
    touchDeltaY = 0;
    if (sheetContent) sheetContent.style.transition = "none";
  }, { passive: true });

  sheetHandle?.addEventListener("touchmove", (e) => {
    touchDeltaY = e.touches[0].clientY - touchStartY;
    if (touchDeltaY > 0 && sheetContent) {
      sheetContent.style.transform = `translateY(${touchDeltaY}px)`;
    }
  }, { passive: true });

  sheetHandle?.addEventListener("touchend", () => {
    if (sheetContent) {
      sheetContent.style.transition = "transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)";
      if (touchDeltaY > 60) {
        sheetContent.style.transform = "translateY(100%)";
        setTimeout(closeModal, 180);
      } else {
        sheetContent.style.transform = "";
      }
    }
    touchStartY = 0;
    touchDeltaY = 0;
  });

  function closeModal() {
    closeImageViewer();
    if (modal) {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }
    if (sheetContent) {
      sheetContent.style.transform = "";
      sheetContent.style.transition = "";
    }
    currentGame = null;
    if (errorEl) errorEl.classList.add("hidden");
  }

  function updateInstalledList() {
    if (!currentGame || !installedSection || !installedList) return;

    const matches = installedData.filter((inst) => {
      if (currentGame.igdb_id && inst.igdb_id) {
        return inst.igdb_id === currentGame.igdb_id;
      }
      return inst.title.toLowerCase() === currentGame.title.toLowerCase();
    });

    if (matches.length > 0) {
      installedSection.classList.remove("hidden");
      installedList.innerHTML = matches
        .map(
          (m) => `
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-white dark:bg-white/10 shadow-sm border border-border dark:border-border-dark">
            <span class="w-2 h-2 rounded-full" style="background:${m.storage_color || '#3b82f6'}"></span>
            ${m.storage_label}
          </span>
        `
        )
        .join("");
    } else {
      installedSection.classList.add("hidden");
      installedList.innerHTML = "";
    }
  }

  function openModal(game: any) {
    if (!modal) return;
    currentGame = game;

    if (titleEl) titleEl.textContent = game.title;

    // Chips (Rating, Year, Genres)
    if (chipsEl) {
      chipsEl.innerHTML = "";
      if (game.rating) {
        const rChip = document.createElement("span");
        rChip.className = "px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400";
        rChip.textContent = `★ ${Math.round(game.rating)}`;
        chipsEl.appendChild(rChip);
      }
      if (game.release_year) {
        const yChip = document.createElement("span");
        yChip.className = "px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-white/10 text-slate-600 dark:text-slate-300";
        yChip.textContent = String(game.release_year);
        chipsEl.appendChild(yChip);
      }
      if (game.genres) {
        const genreList = game.genres.split(",").map((g: string) => g.trim());
        genreList.slice(0, 3).forEach((g: string) => {
          const gChip = document.createElement("span");
          gChip.className = "px-2 py-0.5 rounded-full text-xs font-semibold bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light";
          gChip.textContent = g;
          chipsEl.appendChild(gChip);
        });
      }
    }

    // Cover
    if (coverImg && fallbackSvg) {
      if (game.cover_url) {
        coverImg.src = game.cover_url;
        coverImg.alt = game.title || "";
        coverImg.classList.remove("hidden");
        fallbackSvg.classList.add("hidden");
        if (coverBtn) coverBtn.disabled = false;
        if (coverZoomIcon) coverZoomIcon.classList.remove("hidden");
      } else {
        coverImg.classList.add("hidden");
        fallbackSvg.classList.remove("hidden");
        if (coverBtn) coverBtn.disabled = true;
        if (coverZoomIcon) coverZoomIcon.classList.add("hidden");
      }
    }

    // Platforms
    if (platformsContainer && platformsEl) {
      if (game.platforms) {
        platformsEl.textContent = game.platforms;
        platformsContainer.classList.remove("hidden");
      } else {
        platformsContainer.classList.add("hidden");
      }
    }

    // Summary
    if (summaryEl) {
      summaryEl.textContent = game.summary || "No description available.";
    }

    updateInstalledList();

    if (errorEl) errorEl.classList.add("hidden");
    if (addBtn) {
      addBtn.disabled = false;
      addBtn.textContent = "Add to Storage";
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  // Cover image click opens full screen picture view
  coverBtn?.addEventListener("click", () => {
    if (currentGame?.cover_url) {
      const yearStr = currentGame.release_year ? String(currentGame.release_year) : "";
      const meta = [yearStr, currentGame.genres].filter(Boolean).join(" · ");
      (window as any).openImageViewer?.(currentGame.cover_url, currentGame.title, meta);
    }
  });

  // Handle Add to Storage
  addBtn?.addEventListener("click", async () => {
    if (!currentGame) return;
    const targetStorageId = storageSelect?.value;
    if (!targetStorageId) {
      if (errorEl) {
        errorEl.textContent = "Please select a storage medium";
        errorEl.classList.remove("hidden");
      }
      return;
    }

    const selectedOption = storageSelect?.options[storageSelect.selectedIndex];
    const storageLabel = selectedOption?.text || "Storage";

    if (errorEl) errorEl.classList.add("hidden");
    addBtn.disabled = true;
    addBtn.textContent = "Adding…";

    try {
      const payload = {
        igdb_id: currentGame.igdb_id || null,
        title: currentGame.title,
        cover_url: currentGame.cover_url || null,
        release_year: currentGame.release_year || null,
        genres: currentGame.genres || null,
        summary: currentGame.summary || null,
        rating: currentGame.rating || null,
      };

      const res = await fetch(`/api/storage/${targetStorageId}/games`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        throw new Error(d.detail ?? "Failed to add game");
      }

      // Add to local installed tracking
      installedData.push({
        igdb_id: currentGame.igdb_id,
        title: currentGame.title,
        storage_id: parseInt(targetStorageId, 10),
        storage_label: storageLabel.split(" (")[0],
      });

      updateInstalledList();

      (window as any).showToast?.(`"${currentGame.title}" added to storage!`, "success");
      addBtn.textContent = "✓ Added!";
      setTimeout(() => {
        if (addBtn) {
          addBtn.disabled = false;
          addBtn.textContent = "Add to Storage";
        }
      }, 1500);

      window.dispatchEvent(
        new CustomEvent("game-added-to-storage", {
          detail: {
            igdb_id: currentGame.igdb_id,
            title: currentGame.title,
            storage_id: targetStorageId,
          },
        })
      );
    } catch (e: any) {
      if (errorEl) {
        errorEl.textContent = e.message || "Failed to add game";
        errorEl.classList.remove("hidden");
      }
      addBtn.disabled = false;
      addBtn.textContent = "Add to Storage";
    }
  });

  closeBtns?.forEach((btn) => btn.addEventListener("click", closeModal));

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  (window as any).openGameDetailsModal = openModal;
</script>

<style>
  @media (max-width: 639px) {
    .modal-sheet-content {
      animation: sheetSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes sheetSlideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
