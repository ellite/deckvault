---
interface Props {
  user?: { username: string; is_admin: boolean } | null;
  activePage?: "dashboard" | "library" | "browse" | "settings" | "about";
}
const { user, activePage } = Astro.props;
---

<!-- Desktop top nav -->
<header class="hidden md:flex fixed top-0 inset-x-0 z-30 h-14 items-center gap-2 px-6
               bg-white/90 dark:bg-surface-dark/90 backdrop-blur-md
               border-b border-border dark:border-border-dark">
  <a href="/storage" class="flex items-center gap-2.5 mr-4 flex-shrink-0">
    <img src="/logo.svg?v=20260924-2" alt="" class="w-7 h-7" />
    <span class="font-bold text-base tracking-tight">DeckVault</span>
  </a>

  <nav class="flex items-center gap-1 flex-1">
    <a href="/storage"
       class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors ${
         activePage === "dashboard"
           ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light"
           : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white"
       }`}>
      Storage
    </a>
    <a href="/library"
       class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors ${
         activePage === "library"
           ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light"
           : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white"
       }`}>
      Library
    </a>
    <a href="/browse"
       class={`px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors ${
         activePage === "browse"
           ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light"
           : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white"
       }`}>
      Browse
    </a>
  </nav>

  <div class="flex items-center gap-2 flex-shrink-0">
    <button id="theme-toggle-nav" class="btn-ghost p-2 rounded-xl" aria-label="Toggle theme">
      <svg id="nav-sun" class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <svg id="nav-moon" class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>

    {user && (
      <div class="relative pl-2 border-l border-border dark:border-border-dark ml-1" data-user-menu>
        <button
          type="button"
          class="flex items-center gap-2 rounded-xl px-1.5 py-1 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
          aria-label="Open account menu"
          aria-haspopup="menu"
          aria-expanded="false"
          data-user-menu-trigger
        >
          <span class="w-7 h-7 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
            <span class="text-xs font-bold text-primary dark:text-primary-light">{user.username[0].toUpperCase()}</span>
          </span>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-200 max-w-[120px] truncate">{user.username}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 transition-transform" data-user-menu-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="hidden absolute right-0 top-full mt-2 w-48 rounded-xl border border-border dark:border-border-dark bg-white dark:bg-surface-dark shadow-lg p-1.5" role="menu" data-user-menu-panel>
          <a href="/settings" role="menuitem" class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${activePage === "settings" ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light" : "text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/5"}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
            </svg>
            Settings
          </a>
          <a href="/about" role="menuitem" class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${activePage === "about" ? "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light" : "text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/5"}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 16v-4m0-4h.01"/>
            </svg>
            About
          </a>
          <div class="my-1 border-t border-border dark:border-border-dark"></div>
          <button type="button" role="menuitem" class="flex items-center gap-2.5 w-full px-3 py-2 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" data-logout>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Sign out
          </button>
        </div>
      </div>
    )}
  </div>
</header>

<!-- Mobile top bar -->
<header class="md:hidden flex fixed top-0 inset-x-0 z-30 h-14 items-center gap-3 px-4
               bg-white/90 dark:bg-surface-dark/90 backdrop-blur-md
               border-b border-border dark:border-border-dark">
  <a href="/storage" class="flex items-center gap-2">
    <img src="/logo.svg?v=20260924-2" alt="" class="w-6 h-6" />
    <span class="font-bold tracking-tight">DeckVault</span>
  </a>
  <div class="flex-1"></div>
  <button id="theme-toggle-nav-m" class="btn-ghost p-2 rounded-xl" aria-label="Toggle theme">
    <svg class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
    <svg class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
  {user && (
    <div class="relative" data-user-menu>
      <button type="button" class="flex items-center gap-1.5 rounded-xl p-1 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors" aria-label="Open account menu" aria-haspopup="menu" aria-expanded="false" data-user-menu-trigger>
        <span class="w-7 h-7 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
          <span class="text-xs font-bold text-primary dark:text-primary-light">{user.username[0].toUpperCase()}</span>
        </span>
        <span class="text-sm font-medium max-w-[72px] truncate">{user.username}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400 transition-transform" data-user-menu-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div class="hidden absolute right-0 top-full mt-2 w-48 rounded-xl border border-border dark:border-border-dark bg-white dark:bg-surface-dark shadow-lg p-1.5" role="menu" data-user-menu-panel>
        <a href="/settings" role="menuitem" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">Settings</a>
        <a href="/about" role="menuitem" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">About</a>
        <div class="my-1 border-t border-border dark:border-border-dark"></div>
        <button type="button" role="menuitem" class="w-full text-left px-3 py-2 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" data-logout>Sign out</button>
      </div>
    </div>
  )}
</header>

<!-- Mobile bottom nav -->
<nav class="md:hidden fixed bottom-0 inset-x-0 z-30 h-16 flex items-center justify-around
            bg-white/95 dark:bg-surface-dark/95 backdrop-blur-md
            border-t border-border dark:border-border-dark">
  <a href="/storage"
     class={`flex flex-col items-center gap-0.5 px-5 py-2 rounded-xl transition-colors ${
       activePage === "dashboard"
         ? "text-primary dark:text-primary-light"
         : "text-slate-400 dark:text-slate-500"
     }`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={activePage === "dashboard" ? "2.5" : "1.5"}>
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
    </svg>
    <span class="text-[10px] font-medium">Storage</span>
  </a>
  <a href="/library"
     class={`flex flex-col items-center gap-0.5 px-5 py-2 rounded-xl transition-colors ${
       activePage === "library"
         ? "text-primary dark:text-primary-light"
         : "text-slate-400 dark:text-slate-500"
     }`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={activePage === "library" ? "2.5" : "1.5"}>
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
    </svg>
    <span class="text-[10px] font-medium">Library</span>
  </a>
  <a href="/browse"
     class={`flex flex-col items-center gap-0.5 px-3.5 py-2 rounded-xl transition-colors ${
       activePage === "browse"
         ? "text-primary dark:text-primary-light"
         : "text-slate-400 dark:text-slate-500"
     }`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={activePage === "browse" ? "2.5" : "1.5"}>
      <circle cx="12" cy="12" r="10" stroke-width={activePage === "browse" ? "2.5" : "1.5"}/>
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity={activePage === "browse" ? "0.35" : "0"} stroke="currentColor" stroke-width={activePage === "browse" ? "2" : "1.5"}/>
    </svg>
    <span class="text-[10px] font-medium">Browse</span>
  </a>
  <a href="/settings"
     class={`flex flex-col items-center gap-0.5 px-4 py-2 rounded-xl transition-colors ${
       activePage === "settings"
         ? "text-primary dark:text-primary-light"
         : "text-slate-400 dark:text-slate-500"
     }`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={activePage === "settings" ? "2.5" : "1.5"}>
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
    </svg>
    <span class="text-[10px] font-medium">Settings</span>
  </a>
</nav>

<script>
  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("dv-theme", isDark ? "dark" : "light");
  }
  document.getElementById("theme-toggle-nav")?.addEventListener("click", toggleTheme);
  document.getElementById("theme-toggle-nav-m")?.addEventListener("click", toggleTheme);

  async function logout() {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/login";
  }
  document.querySelectorAll<HTMLElement>("[data-user-menu]").forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-user-menu-trigger]");
    const panel = menu.querySelector<HTMLElement>("[data-user-menu-panel]");
    const chevron = menu.querySelector<HTMLElement>("[data-user-menu-chevron]");

    function setOpen(open: boolean) {
      panel?.classList.toggle("hidden", !open);
      chevron?.classList.toggle("rotate-180", open);
      trigger?.setAttribute("aria-expanded", String(open));
    }

    trigger?.addEventListener("click", (event) => {
      event.stopPropagation();
      const willOpen = panel?.classList.contains("hidden") ?? false;
      document.querySelectorAll<HTMLElement>("[data-user-menu-panel]").forEach((otherPanel) => otherPanel.classList.add("hidden"));
      document.querySelectorAll<HTMLButtonElement>("[data-user-menu-trigger]").forEach((otherTrigger) => otherTrigger.setAttribute("aria-expanded", "false"));
      document.querySelectorAll<HTMLElement>("[data-user-menu-chevron]").forEach((otherChevron) => otherChevron.classList.remove("rotate-180"));
      setOpen(willOpen);
    });
  });

  document.addEventListener("click", () => {
    document.querySelectorAll<HTMLElement>("[data-user-menu-panel]").forEach((panel) => panel.classList.add("hidden"));
    document.querySelectorAll<HTMLButtonElement>("[data-user-menu-trigger]").forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
    document.querySelectorAll<HTMLElement>("[data-user-menu-chevron]").forEach((chevron) => chevron.classList.remove("rotate-180"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") document.dispatchEvent(new MouseEvent("click"));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-logout]").forEach((button) => button.addEventListener("click", logout));
</script>
