---
---

<!-- Global Fullscreen Picture View Lightbox -->
<div
  id="image-viewer-modal"
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/95 backdrop-blur-md select-none touch-none"
  role="dialog"
  aria-modal="true"
  aria-label="Full screen picture view"
>
  <!-- Top bar with title, meta and close button -->
  <div class="fixed top-0 inset-x-0 z-10 flex items-center justify-between p-3 sm:p-5 bg-gradient-to-b from-black/80 via-black/40 to-transparent pointer-events-auto">
    <div class="min-w-0 pr-3">
      <p id="image-viewer-title" class="text-white text-sm sm:text-base font-bold truncate drop-shadow"></p>
      <p id="image-viewer-subtitle" class="text-xs text-slate-300 truncate drop-shadow mt-0.5"></p>
    </div>
    <button
      type="button"
      id="image-viewer-close"
      class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white flex items-center justify-center transition-all backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-white/50 flex-shrink-0 cursor-pointer"
      aria-label="Close picture view"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Loading spinner for high-res upgrade -->
  <div id="image-viewer-spinner" class="absolute inset-0 flex items-center justify-center pointer-events-none hidden z-0">
    <svg class="animate-spin w-8 h-8 text-white/80" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
    </svg>
  </div>

  <!-- Image display container (clicking backdrop closes) -->
  <div id="image-viewer-backdrop" class="w-full h-full flex items-center justify-center p-3 sm:p-8 cursor-zoom-out">
    <img
      id="image-viewer-img"
      src=""
      alt=""
      class="max-w-full max-h-[85dvh] sm:max-h-[88vh] object-contain rounded-xl shadow-2xl transition-all duration-200 cursor-default select-none animate-scaleIn pointer-events-auto"
      referrerpolicy="no-referrer"
    />
  </div>
</div>

<script>
  const imageViewerModal = document.getElementById("image-viewer-modal");
  const imageViewerClose = document.getElementById("image-viewer-close");
  const imageViewerBackdrop = document.getElementById("image-viewer-backdrop");
  const imageViewerImg = document.getElementById("image-viewer-img") as HTMLImageElement | null;
  const imageViewerTitle = document.getElementById("image-viewer-title");
  const imageViewerSubtitle = document.getElementById("image-viewer-subtitle");
  const imageViewerSpinner = document.getElementById("image-viewer-spinner");

  let isImageViewerOpen = false;

  function openImageViewer(src: string, title?: string, subtitle?: string) {
    if (!imageViewerModal || !imageViewerImg || !src) return;

    if (imageViewerTitle) imageViewerTitle.textContent = title || "";
    if (imageViewerSubtitle) imageViewerSubtitle.textContent = subtitle || "";

    // Show initial image immediately
    imageViewerImg.src = src;
    imageViewerImg.alt = title || "Picture";

    // If it's an IGDB image, attempt to upgrade to 1080p
    if (src.includes("images.igdb.com") && src.includes("/t_cover_big/")) {
      const highRes = src.replace("/t_cover_big/", "/t_1080p/");
      const loader = new Image();
      loader.referrerPolicy = "no-referrer";
      if (imageViewerSpinner) imageViewerSpinner.classList.remove("hidden");
      loader.onload = () => {
        if (isImageViewerOpen && imageViewerImg) {
          imageViewerImg.src = highRes;
        }
        if (imageViewerSpinner) imageViewerSpinner.classList.add("hidden");
      };
      loader.onerror = () => {
        if (imageViewerSpinner) imageViewerSpinner.classList.add("hidden");
      };
      loader.src = highRes;
    } else {
      if (imageViewerSpinner) imageViewerSpinner.classList.add("hidden");
    }

    imageViewerModal.classList.remove("hidden");
    imageViewerModal.classList.add("flex");
    isImageViewerOpen = true;
  }

  function closeImageViewer() {
    if (!imageViewerModal) return;
    imageViewerModal.classList.remove("flex");
    imageViewerModal.classList.add("hidden");
    if (imageViewerImg) imageViewerImg.src = "";
    if (imageViewerSpinner) imageViewerSpinner.classList.add("hidden");
    isImageViewerOpen = false;
  }

  imageViewerClose?.addEventListener("click", closeImageViewer);

  imageViewerBackdrop?.addEventListener("click", (e) => {
    if (e.target === imageViewerBackdrop) {
      closeImageViewer();
    }
  });

  // Touch gesture to dismiss on mobile
  let imgTouchStartY = 0;
  imageViewerModal?.addEventListener(
    "touchstart",
    (e) => {
      imgTouchStartY = e.touches[0]?.clientY || 0;
    },
    { passive: true }
  );

  imageViewerModal?.addEventListener(
    "touchend",
    (e) => {
      const touchEndY = e.changedTouches[0]?.clientY || 0;
      const diffY = Math.abs(touchEndY - imgTouchStartY);
      if (diffY > 60) {
        closeImageViewer();
      }
    },
    { passive: true }
  );

  window.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Escape" && isImageViewerOpen) {
        closeImageViewer();
        e.stopImmediatePropagation();
        e.stopPropagation();
      }
    },
    true
  );

  (window as any).openImageViewer = openImageViewer;
  (window as any).closeImageViewer = closeImageViewer;
</script>

<style>
  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-scaleIn {
    animation: scaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
