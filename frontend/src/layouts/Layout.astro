---
import NavBar from "../components/NavBar.astro";
import Toast from "../components/Toast.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import ImageViewerModal from "../components/ImageViewerModal.astro";

interface Props {
  title?: string;
  fullPage?: boolean;
  showNav?: boolean;
  user?: any;
  activePage?: "dashboard" | "library" | "browse" | "settings" | "about";
}
const { title = "DeckVault", fullPage = false, showNav = false, user, activePage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#f0f9f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1628" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="Track your Steam Deck games across all storage mediums" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg?v=20260924-2" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png?v=20260924-2" />
    <link rel="manifest" href="/manifest.webmanifest?v=20260924-2" crossorigin="use-credentials" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DeckVault" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title} | DeckVault</title>

    <script is:inline>
      const saved = localStorage.getItem("dv-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = saved === "dark" || (!saved && prefersDark);
      if (isDark) document.documentElement.classList.add("dark");
      const themeColorMeta = document.querySelector('meta[name="theme-color"][media]');
      if (themeColorMeta) themeColorMeta.setAttribute("content", isDark ? "#0a1628" : "#f0f9f8");
    </script>
  </head>

  <body class={[
    fullPage ? "min-h-dvh flex items-center justify-center" : "min-h-dvh",
    showNav ? "pt-14 pb-16 md:pb-0" : "",
  ].join(" ")}>
    {showNav && <NavBar user={user} activePage={activePage} />}
    <slot />
    <Toast />
    <ConfirmDialog />
    <ImageViewerModal />

    <script>
      if ("serviceWorker" in navigator) {
        if (import.meta.env.DEV) {
          Promise.all([
            navigator.serviceWorker.getRegistrations()
              .then((registrations) => Promise.all(registrations.map((registration) => registration.unregister()))),
            caches.keys()
              .then((keys) => Promise.all(keys.filter((key) => key.startsWith("deckVault-")).map((key) => caches.delete(key)))),
          ]).then(() => {
            if (navigator.serviceWorker.controller && !sessionStorage.getItem("dv-sw-dev-cleanup")) {
              sessionStorage.setItem("dv-sw-dev-cleanup", "1");
              window.location.reload();
            }
          }).catch(() => {});
        } else {
          navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" })
            .then((registration) => registration.update())
            .catch(() => {});
        }
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
